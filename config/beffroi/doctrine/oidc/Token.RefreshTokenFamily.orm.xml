<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- The lineage of refresh tokens descending from one record read once (architecture §4.6), a row of its own that every token of the lineage names. It is a table and not an embeddable because two of its fields are what the provider searches by, the family of a token and the record that granted it, and a search is what a column answers. The hash of that record is unique: a record read once grants one lineage, and a second row under it would be a code spent twice. -->
    <entity name="Beffroi\Oidc\Domain\Token\RefreshTokenFamily" table="beffroi_refresh_token_family">
        <indexes>
            <!-- What the sweep of the dead rows reads (issue #177): a lineage that cannot be refreshed again is what ends the retention of every token of it, so the date is asked of this table and never subtracted row by row. -->
            <index name="beffroi_refresh_token_family_expiry" columns="expires_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="beffroi_refresh_token_family_granting_record" columns="granting_record_hash"/>
        </unique-constraints>
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Beffroi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <field name="grantingRecordHash" type="string" column="granting_record_hash" length="64">
            <options>
                <option name="fixed">true</option>
            </options>
        </field>
        <field name="grantId" type="uuid" column="grant_id"/>
        <field name="startedAt" type="datetime_immutable" column="started_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
    </entity>
</doctrine-mapping>
