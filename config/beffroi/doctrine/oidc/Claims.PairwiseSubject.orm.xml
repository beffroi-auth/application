<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- The identifier one sector of a tenant sees a user under (OIDC Core §8.1). The value is computed from the sector, the user and the salt of the tenant, so this table decides nothing; it is what makes the way back possible, a hash going one way. One identifier per sector and per user, and one user per identifier in a sector: both are unique, so a row written twice by two workers at once is one row. -->
    <entity name="Beffroi\Oidc\Domain\Claims\PairwiseSubject" table="beffroi_pairwise_subject">
        <unique-constraints>
            <unique-constraint name="beffroi_pairwise_subject_identifier" columns="tenant_id,sector,subject"/>
            <unique-constraint name="beffroi_pairwise_subject_user" columns="tenant_id,sector,user_id"/>
        </unique-constraints>
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Beffroi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="user" target-entity="Beffroi\Core\Domain\Identity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="sector" type="beffroi_sector_identifier" column="sector" length="255"/>
        <field name="subject" type="beffroi_subject" column="subject" length="255"/>
        <field name="assignedAt" type="datetime_immutable" column="assigned_at"/>
    </entity>
</doctrine-mapping>
