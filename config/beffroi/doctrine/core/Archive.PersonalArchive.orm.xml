<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
      Everything this provider knows of one person, in one file they asked for (RGPD articles 15 and 20,
      issue #453). The row exists from the moment they ask and the document is written into it later, off
      the request, which is why "content" and "built_at" are nullable: an archive still being built is a
      row that says so, and a page that says so is what the issue asks for instead of giving nothing.

      "content" is sealed under the data key of the tenant, in a scope of its own (decisions 0011 and
      0018). It is the one column of this schema where everything the eleven other families seal stands in
      clear at once, and it carries no exemption for that: the whole point of sealing a column is that a
      dump of the database gives nothing away, and a dump that read this one would give away all of it.

      "expires_at" is set when the person asks and never moved, so the row always carries the date it goes
      away on: one whose build never ran is forgotten on the same date as one whose build did. The index is
      what the timed step reads, which walks by that date (App\Message\ForgetTheExpiredArchives).
    -->
    <entity name="Beffroi\Core\Domain\Archive\PersonalArchive" table="beffroi_personal_archive">
        <indexes>
            <!-- What a page of the account reads: the last archive of one person. -->
            <index name="beffroi_personal_archive_person" columns="user_id,asked_at"/>
            <!-- What the timed step reads, which walks by the date a row goes away on and not by identifier. -->
            <index name="beffroi_personal_archive_expiry" columns="tenant_id,expires_at"/>
        </indexes>
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Beffroi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <many-to-one field="user" target-entity="Beffroi\Core\Domain\Identity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="askedAt" type="datetime_immutable" column="asked_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="builtAt" type="datetime_immutable" column="built_at" nullable="true"/>
        <field name="content" type="beffroi_encrypted_personal_archive_text" column="content" nullable="true"/>
    </entity>
</doctrine-mapping>
