<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Beffroi\Core\Domain\Group\GroupMembership" table="beffroi_group_membership">
        <unique-constraints>
            <unique-constraint name="beffroi_group_membership_member" columns="group_id,user_id"/>
        </unique-constraints>
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Beffroi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="group" target-entity="Beffroi\Core\Domain\Group\Group">
            <join-column name="group_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <many-to-one field="user" target-entity="Beffroi\Core\Domain\Identity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="source" type="string" column="source" length="32" enum-type="Beffroi\Core\Domain\Group\GroupSource"/>
        <field name="addedAt" type="datetime_immutable" column="added_at"/>
    </entity>
</doctrine-mapping>
