<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
      A passkey of a user, several per user: the credential record of WebAuthn Level 3 §6.1.4 with its name
      and its revocation; the row stays once revoked. The credential ID is unique in the tenant (§7.1, step
      26), the user handle is looked up by the authentication ceremony.

      Two columns carry a personal datum and are sealed under the data key of its tenant (decisions 0011
      and 0018): the name, which is what its owner typed to tell their keys apart, and the serial number an
      enterprise attestation carries (§8.2.2), which designates one device and through it one person. Every
      other column of this table says why it is not, in the classification of the schema: the credential ID,
      the public key, the signature counter, the transports, the backup flags and the AAGUID are published by
      the authenticator or by the browser already, what the enrolment proved of the model holds alike for
      every authenticator of that model, and the user handle is drawn at random and designates nobody without
      this table (§14.6.1).

      The user handle stays in the clear because the authentication ceremony matches on it, and the
      credential ID because that is what a ceremony finds a row by (CredentialRepositoryInterface
      ::findByExternalId). Neither needs a blind index: neither is a value a person gave.
    -->
    <entity name="Beffroi\Core\Domain\Credential\PasskeyCredential" table="beffroi_passkey_credential">
        <unique-constraints>
            <unique-constraint name="beffroi_passkey_credential_id" columns="tenant_id,credential_id"/>
        </unique-constraints>
        <indexes>
            <index name="beffroi_passkey_credential_user_handle" columns="tenant_id,user_handle"/>
        </indexes>
        <!-- The length is the one the domain checks (PasskeyCredential::NAME_MAX_LENGTH) and not the width of the column, a sealed column being unbounded binary. -->
        <field name="name" type="beffroi_encrypted_passkey_credential_string" column="name" length="255"/>
        <!-- externalId: the credential ID, under the name every kind presented by an identifier maps (ExternallyIdentifiedCredentialInterface), so that the repository names no kind -->
        <field name="externalId" type="beffroi_bytes" column="credential_id"/>
        <field name="publicKey" type="beffroi_bytes" column="public_key"/>
        <field name="signCount" type="bigint" column="sign_count"/>
        <field name="transports" type="jsonb" column="transports"/>
        <field name="backupEligible" type="boolean" column="backup_eligible"/>
        <field name="backedUp" type="boolean" column="backed_up"/>
        <field name="aaguid" type="uuid" column="aaguid"/>
        <!-- A row written before the policy of its tenant was read declares its model, as every enrolment did (decision 0046). -->
        <field name="modelProof" type="string" column="model_proof" length="16" enum-type="Beffroi\Core\Domain\Credential\Attestation\ModelProof">
            <options>
                <option name="default">declared</option>
            </options>
        </field>
        <field name="serialNumber" type="beffroi_encrypted_passkey_credential_string" column="serial_number" nullable="true"/>
        <field name="underSecurityAlert" type="boolean" column="under_security_alert">
            <options>
                <option name="default">false</option>
            </options>
        </field>
        <field name="userHandle" type="beffroi_passkey_user_handle" column="user_handle" length="86"/>
    </entity>
</doctrine-mapping>
