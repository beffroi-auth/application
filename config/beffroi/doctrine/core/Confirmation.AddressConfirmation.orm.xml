<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- What every kind of confirmation of an address shares, each kind in a table of its own (NIST SP 800-63B-4 section 4.2.1.2, decision 0026): the identifier the link carries, a hash of the code and one of the value of the link, each bound to the address they were sent to, the wrong codes typed, and the three dates that say whether it still establishes anything. The row holds nothing of the address. -->
    <mapped-superclass name="Beffroi\Core\Domain\Confirmation\AddressConfirmation">
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Beffroi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="user" target-entity="Beffroi\Core\Domain\Identity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="code" type="beffroi_password_hash" column="code"/>
        <field name="link" type="beffroi_password_hash" column="link"/>
        <field name="failures" type="integer" column="failures"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="spentAt" type="datetime_immutable" column="spent_at" nullable="true"/>
    </mapped-superclass>
</doctrine-mapping>
