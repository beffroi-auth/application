<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Who is authenticated, since when, how and from where (architecture §3.2, §3.5): the proofs as one document, the provenance of the first and of the last request as one sealed column each. -->
    <entity name="Beffroi\Core\Domain\Session\AuthenticationSession" table="beffroi_authentication_session">
        <indexes>
            <!-- What the sweep of the dead rows reads (issue #177): a session waits what a token still needs past the instant it stopped granting, which is its expiry whether it was ended before it or not. -->
            <index name="beffroi_authentication_session_expiry" columns="expires_at"/>
        </indexes>
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Beffroi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <!-- Loaded with the session and never behind a proxy (issue #877): a session is read for the person it
             names, which every token of it carries and every act of it announces. A grant reads the session its
             record descends from before it spends what the request presented (architecture §4.5), so the
             columns of the person, sealed under a data key of the tenant (decision 0018), are opened with it, and
             a KMS that does not answer is met before the spending rather than at the first claim struck after
             it. -->
        <many-to-one field="user" target-entity="Beffroi\Core\Domain\Identity\User" fetch="EAGER">
            <join-column name="user_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="establishedAt" type="datetime_immutable" column="established_at"/>
        <field name="proofs" type="beffroi_authentication_proofs" column="proofs"/>
        <!--
          The provenance of a request, one column and one JSON document, sealed under the data key of its
          tenant (decisions 0011 and 0018). It was five columns of an embeddable, which could not seal: an
          embeddable fixes the type of each of its fields once for the whole model, so the same field could
          not carry the type of each of the three tables that hold a context. Nothing is lost, the object
          being immutable and replaced whole by the asynchronous enrichment, and no query reading a column
          of a context on its own.
        -->
        <field name="createdFrom" type="beffroi_encrypted_authentication_session_request_context" column="created_from"/>
        <field name="lastSeenFrom" type="beffroi_encrypted_authentication_session_request_context" column="last_seen_from"/>
        <field name="lastSeenAt" type="datetime_immutable" column="last_seen_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="endedAt" type="datetime_immutable" column="ended_at" nullable="true"/>
        <field name="endedBy" type="string" column="ended_by" length="32" nullable="true" enum-type="Beffroi\Core\Domain\Session\SessionEnd"/>
    </entity>
</doctrine-mapping>
