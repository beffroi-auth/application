{# The layout of the pages of the demonstration (issue #462), which are not pages of the product: they
   are not styled by the stylesheet of the application, they extend no layout of the provider, and they are
   routed in development only. The look is here, in one place, because a lab page that needed a build
   step would be a lab page nobody opens.

   The block carries the nonce of the response: the pages of this application are served under
   "style-src 'self'" (config/packages/nelmio_security.yaml), and a nonce is what lets this one block
   through without letting an injected one through with it. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %} &middot; the demonstration</title>
    <style nonce="{{ csp_nonce('style') }}">
        :root {
            --paper: #10131a;
            --panel: #171b24;
            --line: #272d3a;
            --ink: #d8dee9;
            --faint: #8b95a7;
            --accent: #7aa2f7;
            --failed: #f7768e;
            --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 2rem 1rem 4rem;
            background: var(--paper);
            color: var(--ink);
            font: 15px/1.6 system-ui, sans-serif;
        }
        main { max-width: 64rem; margin: 0 auto; }
        a { color: var(--accent); }
        h1 { font-size: 1.4rem; margin: 0 0 .25rem; }
        h1 code { font-size: 1.1rem; }
        p.lead { color: var(--faint); margin: 0 0 2rem; }
        code, pre { font-family: var(--mono); }
        pre {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: .75rem 1rem;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
            margin: 0 0 1rem;
        }
        .card {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 1rem;
        }
        .card h2 { font-size: 1rem; margin: 0 0 .5rem; }
        .faint { color: var(--faint); }
        .actors {
            position: relative;
            display: grid;
            grid-template-columns: repeat(var(--actors, 4), 1fr);
            gap: .5rem;
            margin: 1rem 0 2.25rem;
        }
        .actor {
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: .6rem .4rem;
            text-align: center;
            font-family: var(--mono);
            font-size: .8rem;
            color: var(--faint);
            background: var(--panel);
        }
        .actor[data-here] { color: var(--ink); border-color: var(--accent); }
        /* One marker, moved by the stylesheet: the script sets which actor it sits at and nothing else. */
        .marker {
            position: absolute;
            bottom: -1.1rem;
            width: 14px;
            height: 14px;
            margin-left: -7px;
            border-radius: 50%;
            background: var(--accent);
            left: calc((var(--at, 0) + .5) / var(--actors, 4) * 100%);
            transition: left .5s ease;
        }
        .marker[data-failed] { background: var(--failed); }
        .controls { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; margin: 1rem 0; }
        .controls button, .controls label {
            font: inherit;
            color: var(--ink);
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: .35rem .9rem;
            cursor: pointer;
        }
        .controls button[disabled] { opacity: .45; cursor: default; }
        .controls form { display: contents; }
        ol.plan { list-style: none; margin: 0; padding: 0; }
        ol.plan li {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
            align-items: baseline;
            padding: .3rem .5rem;
            border-left: 2px solid var(--line);
            color: var(--faint);
        }
        ol.plan li[data-taken] { color: var(--ink); border-left-color: var(--accent); }
        ol.plan li[data-failed] { border-left-color: var(--failed); }
        ol.plan li[data-current] { background: var(--panel); }
        .badge {
            font-family: var(--mono);
            font-size: .72rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 0 .5rem;
        }
        .failed { color: var(--failed); }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
        th { color: var(--faint); font-weight: 500; font-size: .8rem; }
    </style>
</head>
<body>
<main>
    <h1>{% block heading %}{{ block('title') }}{% endblock %}</h1>
    <p class="lead">{% block lead %}{% endblock %}</p>
    {% block content %}{% endblock %}
</main>
</body>
</html>
