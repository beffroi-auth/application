{# The page where a person poses a new password with a ticket, without the one in use and without a session
   (decision 0026), in the language of the browser: it names the account the ticket of its URL opens. The
   password is typed twice and the meter beside it is the script of the provider, as on the page of the
   account (account/password.html.twig); once it is written, every session of the person ends, which the
   page says before it is asked for. "refusal" is a code of PasswordTicketSettingController or of the
   refusals of the core. The username rides in a hidden field so that a password manager files the new
   password under the right account; nothing reads it back. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'password_ticket.title'|trans }}{% endblock %}

{% block head %}
    <script src="{{ path('beffroi_interaction_password_strength_script') }}" defer></script>
{% endblock %}

{% block content %}
    <p>{{ 'password_ticket.prompt'|trans({username: user.username}) }}</p>
    {% if refusal is not null %}
        <p data-error="{{ refusal }}">{{ ('password.error.' ~ refusal)|trans({minimum: minimum}) }}</p>
    {% endif %}
    <form method="post" action="{{ path('beffroi_interaction_password_ticket_set', ticket) }}" data-password="ticket">
        <input type="hidden" name="_token" value="{{ csrf_token('beffroi_password_ticket') }}">
        <input type="text" name="username" value="{{ user.username }}" autocomplete="username" hidden readonly>
        <p>{{ 'password_ticket.what_happens'|trans }}</p>
        <label for="password-new">{{ 'password.new'|trans }}</label>
        <input type="password" id="password-new" name="new_password" minlength="{{ minimum }}" autocomplete="new-password" required
               data-password-strength="password-strength"
               data-strength-floor="{{ floor }}"
               data-strength-labels="{{ rungs|map(key => key|trans)|json_encode }}">
        <p id="password-strength" data-strength-meter hidden></p>
        <label for="password-again">{{ 'password.again'|trans }}</label>
        <input type="password" id="password-again" name="new_password_again" minlength="{{ minimum }}" autocomplete="new-password" required>
        <button type="submit">{{ 'password_ticket.submit'|trans }}</button>
    </form>
{% endblock %}
