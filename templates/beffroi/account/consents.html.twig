{# What the signed-in user has agreed to (architecture §5.2), in the language of the browser: one line
   per client that may obtain something about them, what each was granted and when, and the button that
   takes one back. The list is narrowed by what ConsentsPage reads ("question", a ConsentQuestion): what
   the name of the application contains, one access of those the consents of the person grant ("granted",
   "access" the one read), and the days it was granted. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'consents.title'|trans }}{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'consents.explanation'|trans }}</p>
    {% embed '@Beffroi/account/filter.html.twig' %}
        {% trans_default_domain 'beffroi' %}
        {% block fields %}
            {{ include('@Beffroi/account/filter_text.html.twig', {name: 'application', label: 'consents.application', typed: question.applicationName}) }}
            {# An access is named as the column names it, a type of authorization details by its name. #}
            {{ include('@Beffroi/account/filter_choice.html.twig', {
                name: 'access',
                label: 'consents.access',
                any: 'consents.filter.every_access',
                options: granted.scopes|map(scope => {value: 'scope:' ~ scope.value, label: include('@Beffroi/scope_word.html.twig', {scope: scope.value})})
                    |merge(granted.claims|map(claim => {value: 'claim:' ~ claim, label: include('@Beffroi/claim_word.html.twig', {claim: claim})}))
                    |merge(granted.types|map(type => {value: 'type:' ~ type, label: type})),
                chosen: access,
            }) }}
            {{ include('@Beffroi/account/filter_period.html.twig', {legend: 'consents.granted_at', from: 'from', to: 'to', period: question.granted}) }}
        {% endblock %}
    {% endembed %}
    <div data-table>
        <table data-consents="{{ consents|length }}">
            <thead>
                <tr>
                    <th>{{ 'consents.application'|trans }}</th>
                    <th>{{ 'consents.access'|trans }}</th>
                    <th>{{ 'consents.granted_at'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for consent in consents %}
                    <tr data-consent="{{ consent.id }}" data-client="{{ consent.clientId }}">
                        <td data-label="{{ 'consents.application'|trans }}"><a href="{{ path('beffroi_interaction_account_application', {id: consent.id}) }}">{{ consent.client.registration.presentation.name }}</a></td>
                        <td data-label="{{ 'consents.access'|trans }}">
                            {{ include('@Beffroi/scopes.html.twig', {scopes: consent.scopes}) }}
                            {% if consent.claims is not empty %}
                                {{ include('@Beffroi/claims.html.twig', {claims: consent.claims}) }}
                            {% endif %}
                            {% if consent.authorizationDetails is not null %}
                                {{ include('@Beffroi/authorization_details.html.twig', {details: consent.authorizationDetails}) }}
                            {% endif %}
                        </td>
                        <td data-label="{{ 'consents.granted_at'|trans }}"><time datetime="{{ consent.grantedAt|date('c') }}">{{ consent.grantedAt|beffroi_moment(user) }}</time></td>
                        <td>
                            <form method="post" action="{{ path('beffroi_interaction_account_consents_revoke', {id: consent.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('beffroi_consent_revoke') }}">
                                <button type="submit" name="revoke" value="{{ consent.id }}">{{ 'consents.revoke'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    {# A table that holds nothing keeps its head and says so in one row of its own, which is
                       how every table of this plane says it. #}
                    <tr data-empty><td colspan="4">{{ (narrowed ? 'consents.none_matching' : 'consents.none')|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ include('@Beffroi/account/pager.html.twig', {listing: consents}) }}
{% endblock %}
