{# Where the signed-in user is signed in (architecture §5.2), in the language of the browser: one line per
   session open in their name, what each one proved, when it was opened, when it was last seen and from
   where, and the button that ends one. The session of the browser reading the page says so, because
   ending it signs the reader out.

   The list is narrowed by what SessionsPage reads ("question", a SessionQuestion): the days it was opened,
   the days it was last seen, and a method it proved, "methods" being those the sessions of the person
   proved. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'sessions.title'|trans }}{% endblock %}

{# Ending every other session is what this page offers when there is another one: one act for what
   somebody would otherwise do a line at a time, and the browser reading the page stays signed in. A
   person signed in nowhere else is offered nothing, there being nothing to end. #}
{% block action %}
    {% if sessions.total > 1 %}
        <form method="post" action="{{ path('beffroi_interaction_account_sessions_revoke_others') }}" data-sessions="revoke-others">
            <input type="hidden" name="_token" value="{{ csrf_token('beffroi_sessions_revoke_others') }}">
            <button type="submit">{{ 'sessions.end_others'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'sessions.explanation'|trans }}</p>
    {% embed '@Beffroi/account/filter.html.twig' %}
        {% trans_default_domain 'beffroi' %}
        {% block fields %}
            {{ include('@Beffroi/account/filter_choice.html.twig', {
                name: 'proof',
                label: 'sessions.proved',
                any: 'sessions.filter.every_proof',
                options: methods|map(method => {value: method, label: method}),
                chosen: question.provedWith,
            }) }}
            {{ include('@Beffroi/account/filter_period.html.twig', {legend: 'sessions.opened_at', from: 'from', to: 'to', period: question.opened}) }}
            {{ include('@Beffroi/account/filter_period.html.twig', {legend: 'sessions.last_seen', from: 'seen_from', to: 'seen_to', period: question.seen}) }}
        {% endblock %}
    {% endembed %}
    <div data-table>
        <table data-sessions="{{ sessions|length }}">
            <thead>
                <tr>
                    <th>{{ 'sessions.proved'|trans }}</th>
                    <th>{{ 'sessions.opened_at'|trans }}</th>
                    <th>{{ 'sessions.last_seen'|trans }}</th>
                    <th>{{ 'sessions.from'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for session in sessions %}
                    {% set is_current = session.id.toString == current %}
                    <tr data-session="{{ session.id }}" data-current="{{ is_current ? 'yes' : 'no' }}">
                        <td>
                            <span data-acr="{{ session.authenticationContextClass.value }}">{{ session.authenticationContextClass.value }}</span>
                            <span data-amr="{{ session.proofs.methodReferences|join(' ') }}">{{ session.proofs.methodReferences|join(', ') }}</span>
                        </td>
                        <td><time datetime="{{ session.establishedAt|date('c') }}">{{ session.establishedAt|beffroi_moment(user) }}</time></td>
                        <td><time datetime="{{ session.lastSeenAt|date('c') }}">{{ session.lastSeenAt|beffroi_moment(user) }}</time></td>
                        <td>{{ include('@Beffroi/account/provenance.html.twig', {provenance: session.lastSeenFrom}) }}</td>
                        <td>
                            {% if is_current %}<span data-session-current>{{ 'sessions.this_browser'|trans }}</span>{% endif %}
                            <form method="post" action="{{ path('beffroi_interaction_account_sessions_revoke', {id: session.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('beffroi_session_revoke') }}">
                                <button type="submit" name="revoke" value="{{ session.id }}">{{ (is_current ? 'sessions.end_this_one' : 'sessions.end')|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    {# A table that holds nothing keeps its head and says so in one row of its own, which is
                       how every table of this plane says it. The page of somebody reading it holds their own
                       session, so the row they see here is the one they narrowed to sessions there are none of. #}
                    <tr data-empty><td colspan="5">{{ (narrowed ? 'sessions.none_matching' : 'sessions.none')|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ include('@Beffroi/account/pager.html.twig', {listing: sessions}) }}
{% endblock %}
