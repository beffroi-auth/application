{# The backup codes of a second factor, drawn again because the person asked (architecture §5.2), shown
   this once: the page is the response to the form that asked for them, and the codes are stored hashed,
   so that nothing shows them again. The ones they had stopped working when these were drawn. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'two_factor.backup_codes.title'|trans }}{% endblock %}

{% block head %}
    <script src="{{ path('beffroi_interaction_copy_script') }}" defer></script>
{% endblock %}

{# Taking the codes away is what this page is for, so it is the action it offers, beside its title. #}
{% block action %}
    <button type="button" data-copy="backup-codes" hidden>{{ 'two_factor.backup_codes.copy'|trans }}</button>
    <span data-copied hidden>{{ 'two_factor.backup_codes.copied'|trans }}</span>
{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p data-two-factor="backup-codes-renewed">{{ 'two_factor.backup_codes.renewed'|trans }}</p>
    <p>{{ 'two_factor.enrolled.codes'|trans }}</p>
    {{ include('@Beffroi/account/_backup_codes.html.twig', {backup_codes: backup_codes}) }}
{% endblock %}
