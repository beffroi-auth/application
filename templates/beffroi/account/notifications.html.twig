{# The browsers of the signed-in user this provider may push to (Push API §3.4, architecture §5.2, §5.6), in
   the language of the browser: the list with what the user called each one and its dates, the name
   corrected in the line where it is read, a button that takes one out, and, beside the title, what
   associates the browser showing the page.

   The form that subscribes is hidden until the script of the provider finds a browser that can hold a
   subscription and a tenant that hands out a key, and hidden again when that browser is already one of
   the rows: what the script recognises it by is the digest of its endpoint, which every row carries
   (PushSubscription::digestOf), and the row it matches says it is this browser.

   "application_server_key" is the public half of that key (RFC 8292 §3.2), and null when this deployment
   reaches nobody this way; "error" is a code of PushSubscriptionController or of
   PushSubscriptionNameController. The list is narrowed by what NotificationsPage reads ("question", a
   PushSubscriptionQuestion): the days a browser was added, and the days it was last told something.

   Under the browsers, the channels that tell the user of each kind of notification (decision 0050):
   "channels" those the deployment turns on, the only ones offered; "chosen_kinds" the kinds whose channels
   the user chooses, each of them following the choice for every kind unless they set it apart;
   "every_channel_kinds" those no choice narrows, told by every channel that carries them; "chosen" what
   the user chose, a box checked for every channel while they chose nothing. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'notifications.title'|trans }}{% endblock %}

{% block head %}
    <script src="{{ path('beffroi_interaction_push_script') }}" defer></script>
{% endblock %}

{# Associating this browser is what this page offers, and it is one click: the name that tells one browser
   from another is corrected in its own line afterwards, so nothing is asked before the browser is asked
   for a subscription. #}
{% block action %}
    <form method="post" action="{{ path('beffroi_interaction_account_notifications_subscribe') }}" data-push="subscribe" data-application-server-key="{{ application_server_key ?? '' }}" data-worker-url="{{ path('beffroi_interaction_push_worker') }}" hidden>
        <input type="hidden" name="_token" value="{{ csrf_token('beffroi_push_subscribe') }}">
        <input type="hidden" name="endpoint" value="">
        <input type="hidden" name="p256dh" value="">
        <input type="hidden" name="auth" value="">
        <input type="hidden" name="label" value="{{ 'notifications.new_default'|trans }}">
        <button type="button" data-push-button>{{ 'notifications.subscribe'|trans }}</button>
    </form>
{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'notifications.what_is_sent'|trans }}</p>
    {% if error is not null %}
        <p data-error="{{ error }}">{{ ('notifications.error.' ~ error)|trans }}</p>
    {% endif %}
    {% embed '@Beffroi/account/filter.html.twig' %}
        {% trans_default_domain 'beffroi' %}
        {% block fields %}
            {{ include('@Beffroi/account/filter_period.html.twig', {legend: 'notifications.created_at', from: 'from', to: 'to', period: question.subscribed}) }}
            {{ include('@Beffroi/account/filter_period.html.twig', {legend: 'notifications.last_pushed_at', from: 'told_from', to: 'told_to', period: question.pushed}) }}
        {% endblock %}
    {% endembed %}
    <div data-table>
        <table data-subscriptions="{{ subscriptions|length }}">
            <thead>
                <tr>
                    <th>{{ 'notifications.label'|trans }}</th>
                    <th>{{ 'notifications.created_at'|trans }}</th>
                    <th>{{ 'notifications.last_pushed_at'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for subscription in subscriptions %}
                    <tr data-subscription="{{ subscription.id }}" data-endpoint="{{ subscription.endpointHash }}">
                        <td>
                            {# The name is the holder's and theirs to correct, in the line where they read it.
                               The row of the browser showing the page says so, which only that browser knows:
                               the word is here and the script of the provider uncovers it. #}
                            <form method="post" action="{{ path('beffroi_interaction_account_notifications_name', {id: subscription.id}) }}" data-subscription="rename">
                                <input type="hidden" name="_token" value="{{ csrf_token('beffroi_push_name') }}">
                                <label for="subscription-{{ subscription.id }}-label">{{ 'notifications.label'|trans }}</label>
                                <input type="text" id="subscription-{{ subscription.id }}-label" name="label" value="{{ subscription.label }}" placeholder="{{ 'notifications.unnamed'|trans }}" maxlength="255" required>
                                <button type="submit" data-save>{{ 'notifications.rename'|trans }}</button>
                            </form>
                            <span data-subscription-current hidden>{{ 'notifications.this_browser'|trans }}</span>
                        </td>
                        <td><time datetime="{{ subscription.createdAt|date('c') }}">{{ subscription.createdAt|beffroi_moment(user) }}</time></td>
                        <td>{% if subscription.lastPushedAt is not null %}<time datetime="{{ subscription.lastPushedAt|date('c') }}">{{ subscription.lastPushedAt|beffroi_moment(user) }}</time>{% else %}{{ 'notifications.never_pushed'|trans }}{% endif %}</td>
                        <td>
                            <form method="post" action="{{ path('beffroi_interaction_account_notifications_revoke', {id: subscription.id}) }}" data-subscription="revoke">
                                <input type="hidden" name="_token" value="{{ csrf_token('beffroi_push_revoke') }}">
                                <button type="submit" name="revoke" value="{{ subscription.id }}">{{ 'notifications.revoke'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    {# A table that holds nothing keeps its head and says so in one row of its own, which is
                       how every table of this plane says it. #}
                    <tr data-empty><td colspan="4">{{ (narrowed ? 'notifications.none_matching' : 'notifications.none')|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ include('@Beffroi/account/pager.html.twig', {listing: subscriptions}) }}
    <p data-push-error hidden>{{ 'notifications.error.browser'|trans }}</p>
    <p data-push-unsupported {% if application_server_key is not null %}hidden{% endif %}>{{ application_server_key is null ? 'notifications.not_served'|trans : 'notifications.unsupported'|trans }}</p>
    <h2>{{ 'notifications.channels.title'|trans }}</h2>
    {% if channels is empty %}
        <p data-channels="none">{{ 'notifications.channels.none'|trans }}</p>
    {% else %}
        <p>{{ 'notifications.channels.explanation'|trans }}</p>
        <form method="post" action="{{ path('beffroi_interaction_account_notifications_channels') }}" data-channels="choose">
            <input type="hidden" name="_token" value="{{ csrf_token('beffroi_notification_channels') }}">
            <table data-channels="{{ channels|length }}">
                <thead>
                    <tr>
                        <th>{{ 'notifications.channels.kind'|trans }}</th>
                        <th>{{ 'notifications.channels.apart'|trans }}</th>
                        {% for channel in channels %}
                            <th data-channel="{{ channel }}">{{ ('notifications.channel.' ~ channel)|trans }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% set every_kind = 'notifications.channels.every_kind'|trans %}
                    <tr data-kind="every">
                        <td>{{ every_kind }}</td>
                        <td></td>
                        {% for channel in channels %}
                            <td><input type="checkbox" name="every[]" value="{{ channel }}" aria-label="{{ 'notifications.channels.by'|trans({kind: every_kind, channel: ('notifications.channel.' ~ channel)|trans}) }}" {% if chosen.forEveryKind is null or channel in chosen.forEveryKind %}checked{% endif %}></td>
                        {% endfor %}
                    </tr>
                    {% for kind in chosen_kinds %}
                        {% set named = ('notifications.kind.' ~ kind.name)|trans %}
                        {% set apart = chosen.setApart[kind.name] ?? null %}
                        {% set reaching = apart ?? chosen.forEveryKind %}
                        <tr data-kind="{{ kind.name }}">
                            <td>{{ named }}</td>
                            <td><input type="checkbox" name="apart[]" value="{{ kind.name }}" aria-label="{{ 'notifications.channels.apart_label'|trans({kind: named}) }}" {% if apart is not null %}checked{% endif %}></td>
                            {% for channel in channels %}
                                <td><input type="checkbox" name="channels[{{ kind.name }}][]" value="{{ channel }}" aria-label="{{ 'notifications.channels.by'|trans({kind: named, channel: ('notifications.channel.' ~ channel)|trans}) }}" {% if reaching is null or channel in reaching %}checked{% endif %}></td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    {% for kind in every_channel_kinds %}
                        <tr data-kind="{{ kind.name }}" data-every-channel>
                            <td>{{ ('notifications.kind.' ~ kind.name)|trans }}</td>
                            <td colspan="{{ channels|length + 1 }}">{{ 'notifications.channels.every_channel'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <button type="submit">{{ 'notifications.channels.save'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
