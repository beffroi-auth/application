{# The claims a request asks for one by one, or that a consent holds by name (OIDC Core §5.5), in the
   language of the reader, each said by claim_word. Included by the consent page of an interaction and by
   the pages of the account that list what is in force, so that a claim is said the same way wherever it is
   read. #}
<ul>
    {% for claim in claims %}
        <li data-claim="{{ claim }}">{{ include('@Beffroi/claim_word.html.twig', {claim: claim}) }}</li>
    {% endfor %}
</ul>
