{# What the code names, for the user to approve or refuse (RFC 8628 §3.3, BCP 10027 §2): the provider that
   is asking, the client that asked, where it asked from, the code itself, and every scope of the request,
   the standard scopes of OIDC Core §5.4 in words and any other by its value. The warning is not decoration: somebody who started
   nothing must be told to refuse. The answer is a POST with the token this page renders; a GET approves
   nothing. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% set described_scopes = ['openid', 'profile', 'email', 'address', 'phone', 'offline_access'] %}

{% block title %}{{ 'device.approval.title'|trans({client: client.registration.presentation.name}) }}{% endblock %}

{% set tenant = beffroi_tenant() %}

{% block content %}
    <p data-provider="{{ tenant.name }}">{{ 'device.approval.provider'|trans({provider: tenant.name}) }}</p>
    <p>{{ 'device.approval.signed_in_as'|trans({username: user.username}) }}</p>
    <p>{{ 'device.approval.request'|trans_with_client(client.registration.presentation.name, {code: typed}) }}</p>
    <p data-origin="{{ requested_from.ipAddress ?? '' }}">{{ 'device.approval.origin'|trans({
        address: requested_from.ipAddress ?? ('device.approval.unknown_address'|trans),
        agent: requested_from|beffroi_device|default('device.approval.unknown_agent'|trans),
    }) }}</p>
    <ul>
        {% for scope in scopes %}
            <li data-scope="{{ scope.value }}">{{ scope.value in described_scopes ? ('scope.' ~ scope.value)|trans : scope.value }}</li>
        {% endfor %}
    </ul>
    <p data-warning="unexpected">{{ 'device.approval.unexpected'|trans }}</p>
    <form method="post" action="{{ path('beffroi_interaction_device') }}">
        <input type="hidden" name="user_code" value="{{ typed }}">
        <input type="hidden" name="_token" value="{{ csrf_token('beffroi_device') }}">
        <button type="submit" name="answer" value="allow">{{ 'device.approval.allow'|trans }}</button>
        <button type="submit" name="answer" value="deny">{{ 'device.approval.deny'|trans }}</button>
    </form>
{% endblock %}
