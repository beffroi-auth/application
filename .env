# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://op.localhost
DEFAULT_LOCALE=en
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://heidi:heidi@127.0.0.1:5432/heidi?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=amqp://heidi:heidi@localhost:5672/%2f/messages
###< symfony/messenger ###

###> heidi/symfony-bundle ###
# The issuer every token names and every client compares byte for byte (no trailing slash).
HEIDI_ISSUER=https://op.localhost
# Where a client that presents a certificate reaches the endpoints (RFC 8705 §5, docs/mtls-at-the-edge.md):
# the origin of the host whose TLS listener asks for one, announced in "mtls_endpoint_aliases". It is the
# MTLS_SERVER_NAME of compose.yaml, and it is empty for a deployment that serves one host, which then
# announces no alias.
HEIDI_MTLS_ORIGIN=https://mtls.op.localhost
# The KMS that seals the signing keys and the key of that KMS they are sealed under. Empty here on purpose:
# nothing is sealed nor signed under a key everybody has. "castor provision --kms <backend>" writes them
# into .env.local, and the DSN is the only thing that changes between two backends, the code and the
# envelope are the same (docs/11-architecture.md §3.3); {tenant} in the key id names one master key per
# tenant. An envelope sealed by one backend does not open with another: switching is a rotation.
#   sodium, a key inline in the environment, the development default ("castor provision"):
#     HEIDI_KMS_DSN="sodium://?keys[signing]=<32 bytes, base64url>"      HEIDI_KMS_KEY_ID="signing"
#   file, the same sodium key read from a file of its own, mode 0600, outside the web root and outside the
#   sealed keys ("castor provision --kms file" writes var/kms/heidi-<slug>.key in the container): the
#   self-hosted default when there is no KMS, worth a dump of the storage, not a compromise of the host:
#     HEIDI_KMS_DSN="sodium+dir:///app/var/kms?ext=.key"                 HEIDI_KMS_KEY_ID="heidi-{tenant}"
#   HashiCorp Vault Transit ("castor start --kms vault", "castor provision --kms vault"; the token is minted
#   under the policy of docker/vault/heidi-op.hcl):
#     HEIDI_KMS_DSN="hashicorp-vault-transit://<token>@vault:8200?scheme=http"   HEIDI_KMS_KEY_ID="heidi-{tenant}"
#   AWS KMS, on the desk with LocalStack ("castor start --kms aws", "castor provision --kms aws"; the alias
#   is created by docker/localstack/init.sh) or on an account ("aws-kms://default?region=<region>" and the
#   credentials of the provider chain, the same alias under the key policy of the CISO page):
#     HEIDI_KMS_DSN="aws-kms://test:test@localstack:4566?region=eu-west-3&scheme=http"   HEIDI_KMS_KEY_ID="alias/heidi-{tenant}"
HEIDI_KMS_DSN=
HEIDI_KMS_KEY_ID=
# The plane this process serves: all, interaction or protocol (docs/11-architecture.md §5.2, §6).
HEIDI_PLANE=all
# The windows of a rotation (docs/11-architecture.md §3.3, §9): how long a relying party may cache the JWK Set
# (the staging delay of a new key derives from it), and the lifetimes of the two JWS the tenant issues (the
# retirement window of the key that signed them is the longest one). The choices of the architecture; "castor
# demo --rotate" shortens them in .env.local for the time of its run, so that a whole rotation fits in minutes.
HEIDI_JWKS_MAX_AGE=300
HEIDI_ACCESS_TOKEN_TTL=600
HEIDI_ID_TOKEN_TTL=600
###< heidi/symfony-bundle ###

###> heidi/op ###
# The secrets of the clients of spike 1 (config/packages/heidi.yaml, development only), 32 visible ASCII
# characters at least, generated, never chosen: "castor provision" writes them into .env.local with the
# password of the development user, where "castor conformance" and oidc-demo (#20) read them.
CONFORMANCE_BASIC_SECRET=
CONFORMANCE_BASIC_SECOND_SECRET=
CONFORMANCE_POST_SECRET=
OIDC_DEMO_SECRET=
OIDC_DEMO_OPAQUE_SECRET=
OIDC_DEMO_SECOND_SECRET=
# Where the second instance of oidc-demo answers, for the worker that carries it a logout token: the
# address of the host as docker wrote it into /etc/hosts of the worker, or the loopback address when
# the process runs on the machine itself (config/packages/framework.yaml).
HEIDI_DEMO_HOST_IP=127.0.0.1
# The shape of the access tokens the three clients of the conformance suite receive, "jwt" or "opaque"
# (docs/11-architecture.md §4.6): the plans must be green with either, "castor start --conformance
# --access-token-format opaque" recreates the op container with the second one.
CONFORMANCE_ACCESS_TOKEN_FORMAT=jwt
# The profiler and its toolbar in development; "castor start --conformance" turns them off for the op
# container, a plan of a hundred requests has no use for a hundred profiles.
APP_PROFILER=1
###< heidi/op ###
