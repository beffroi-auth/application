# The size of a request is bounded here, before PHP runs (architecture §6). The request line and the headers, on the
# listener of the sites, by CADDY_MAX_HEADER_SIZE (431, RFC 6585 §5), whose default is the one of Caddy itself, written
# here so that the environment sets it and no newer base image moves it. The body by CADDY_REQUEST_BODY_MAX_SIZE on the
# site of SERVER_NAME and the mTLS site, and by CADDY_ADMINISTRATION_REQUEST_BODY_MAX_SIZE on the site of
# administration.Caddyfile (413, RFC 9110 §15.5.14), whether its length is announced or it is chunked. Their defaults
# let through the largest form beffroi/saml2-bindings reads a SAML message from, and the largest S/MIME key with its
# certificates the administration API takes.
#
# Caddy refuses a second "servers" block for the same listeners: the options a deployment gives them all,
# "trusted_proxies" and "client_ip_headers" behind a proxy, are CADDY_SERVER_OPTIONS, inside this block, never a
# "servers" block of CADDY_GLOBAL_OPTIONS.
{
	{$CADDY_GLOBAL_OPTIONS}

	servers {
		max_header_size {$CADDY_MAX_HEADER_SIZE:16KiB}
		{$CADDY_SERVER_OPTIONS}
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

# The TLS a FAPI 1 plan measures, imported by the site of SERVER_NAME when Caddy terminates its TLS and by
# the site of mtls.Caddyfile. FAPI 1.0 Advanced Final §8.5 permits four cipher suites below TLS 1.3 and
# every one of them is authenticated by an RSA certificate: the two TLS_DHE_RSA ones, which no listener
# built on Go can offer since Go implements no DHE suite, and the two TLS_ECDHE_RSA ones named here.
#
# The certificate therefore carries an RSA key. On the ECDSA key Caddy issues by default, the only suites
# that can be negotiated below TLS 1.3 are the TLS_ECDHE_ECDSA ones, which §8.5 does not list: a listener
# offering the permitted list and serving an ECDSA certificate has no suite left to negotiate, and one
# offering the ECDSA suites as well negotiates a suite the profile refuses. The DisallowInsecureCipher
# check of the fapi-ciba-id1 plan opens a TLS 1.2 handshake offering every code point but those four, and
# fails the run on whichever one the listener accepts.
#
# TLS 1.3 needs no list: its suites are fixed by RFC 8446 §9.1 and §8.5 rules on the versions below it
# only, which is also the one version that check negotiates. TLS 1.2 is already the floor of Caddy, which
# is what §8.5 asks for.
#
# What this file answers for is the listener the image ships with: a certification run against this stack
# then measures the provider and not the defaults of an image. A deployment behind a proxy that terminates
# TLS answers for the TLS of that proxy, which is the one its clients meet on the host of SERVER_NAME.
(fapi_tls) {
	key_type rsa2048

	ciphers TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
}

# What the site of SERVER_NAME serves, whoever terminates its TLS.
(provider) {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	request_body {
		max_size {$CADDY_REQUEST_BODY_MAX_SIZE:2MiB}
	}

	root * /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}

# The site of SERVER_NAME, imported at the end of this file as "tls_terminated_by_" followed by the value of
# TLS_TERMINATION, which names who terminates its TLS (issue #908). "caddy", when the variable is not set:
# Caddy, with the TLS above, on the address SERVER_NAME gives, a plain HTTP one being refused ("server
# listening on [:80] is HTTP, but attempts to configure TLS connection policies"). "proxy": a proxy in front
# of the image, which sends the site plain HTTP. SERVER_NAME then names one host, the one the proxy asks for,
# or ":<port>" for any host, without a scheme, and the site is "http://" followed by it, in quotes: the
# provider is served on plain HTTP, and never with the TLS Caddy chooses by default for a host, since a list
# of hosts is refused or read as one address rather than giving the hosts after the first a site over TLS.
# A misspelt value names no snippet, and Caddy refuses to start.
#
# Behind the proxy, Symfony reads the scheme and the address of the client in what the proxy forwards, from
# the proxies SYMFONY_TRUSTED_PROXIES names: without them, every request reads as plain HTTP and comes from
# the address of the proxy, and a request of a safe method, such as a GET, is sent to HTTPS again and again.
#
# The host of mtls.Caddyfile keeps its TLS here whatever this says: a client presents its certificate in the
# handshake, which a proxy that terminates TLS ends before Caddy, so a proxy passes the connections of that
# host through.
(tls_terminated_by_caddy) {
	{$SERVER_NAME:localhost} {
		tls {
			import fapi_tls
		}

		import provider
	}
}

(tls_terminated_by_proxy) {
	"http://{$SERVER_NAME:localhost}" {
		import provider
	}
}

{$CADDY_EXTRA_CONFIG}

import tls_terminated_by_{$TLS_TERMINATION:caddy}
